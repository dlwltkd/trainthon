{
  "name": "vouch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "cli": "tsx apps/cli/src/index.ts",
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:server": "pnpm --filter @vouch/server dev",
    "dev:dashboard": "pnpm --filter @vouch/dashboard dev",
    "build:dashboard": "pnpm --filter @vouch/dashboard build",
    "test": "vitest run && pnpm --filter @vouch/dashboard test:ui",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter @vouch/dashboard typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
