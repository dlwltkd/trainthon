# Blue defaults to gpt-5.6-sol through OpenAI.
OPENAI_API_KEY=

# Red defaults to glm-5.3-flash-uncensored through Routeway.
ROUTEWAY_API_KEY=

# Optional: draft PR delivery to public repositories where this token has push access.
# Requires Contents and Pull requests write permissions. Never sent to model providers.
GITHUB_TOKEN=

# VOUCH_BLUE_* and VOUCH_RED_* variables may override the pinned profiles.
