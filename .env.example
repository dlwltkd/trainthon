# Blue repairs the repository. Replace this placeholder with an exact model ID.
VOUCH_BLUE_MODEL=replace-with-exact-openai-model-id
VOUCH_BLUE_PROVIDER=openai
VOUCH_BLUE_API_KEY_ENV=OPENAI_API_KEY
OPENAI_API_KEY=

# Red reviews evidence through Routeway with read-only tools.
VOUCH_RED_MODEL=glm-5.3-flash-uncensored
VOUCH_RED_PROVIDER=compatible
VOUCH_RED_BASE_URL=https://api.routeway.ai/v1
VOUCH_RED_API_KEY_ENV=ROUTEWAY_API_KEY
ROUTEWAY_API_KEY=
