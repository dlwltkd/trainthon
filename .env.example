# Anthropic (Blue / baseline / condition B)
ANTHROPIC_API_KEY=

# OpenAI (alternative Blue / baseline)
OPENAI_API_KEY=

# OpenAI-compatible gateway for Red (Routeway default).
# CLI/server do NOT auto-load this file — `set -a && source .env && set +a`
ROUTEWAY_API_KEY=
VOUCH_RED_MODEL=
VOUCH_RED_PROVIDER=compatible
VOUCH_RED_BASE_URL=https://api.routeway.ai/v1
VOUCH_RED_API_KEY_ENV=ROUTEWAY_API_KEY

# API server (pnpm dev / pnpm server)
# PORT=8787
